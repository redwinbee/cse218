<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.home.HomeController">
    <children>
        <HBox layoutX="16.0" layoutY="30.0" spacing="10.0">
            <children>
                <TextArea fx:id="postArea" prefHeight="74.0" prefWidth="497.0" promptText="What's on your mind?" wrapText="true" />
                <Button fx:id="post" mnemonicParsing="false" onAction="#onPost" prefHeight="92.0" prefWidth="58.0" text="Post" />
            </children>
        </HBox>
      <ScrollPane fx:id="postsPane" hbarPolicy="NEVER" layoutY="122.0" prefHeight="279.0" prefWidth="600.0" vbarPolicy="NEVER">
         <content>
            <VBox fx:id="posts" prefHeight="275.0" prefWidth="495.0" />
         </content>
      </ScrollPane>
        <Label alignment="CENTER" layoutX="232.0" layoutY="6.0" text="Social Media Application">
            <font>
                <Font name="PT Sans" size="13.0" />
            </font>
        </Label>
    </children>
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>
</AnchorPane>
