<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/19" fx:controller="controller.Login">
    <children>
        <VBox alignment="CENTER" fillWidth="false" spacing="10.0">
            <children>
                <TextField fx:id="userNameField" promptText="username"/>
                <PasswordField fx:id="passwordField" promptText="password"/>
                <HBox spacing="10.0">
                    <children>
                        <Button fx:id="loginButton" defaultButton="true" mnemonicParsing="false" onAction="#handleLogin"
                                text="Login"/>
                        <Button fx:id="registerButton" mnemonicParsing="false" onAction="#handleRegister"
                                text="Register"/>
                    </children>
                </HBox>
            </children>
            <opaqueInsets>
                <Insets/>
            </opaqueInsets>
            <padding>
                <Insets bottom="50.0" left="50.0" right="50.0" top="50.0"/>
            </padding>
        </VBox>
    </children>
</AnchorPane>
