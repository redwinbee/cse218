<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/19" fx:controller="controller.Login">
    <VBox alignment="CENTER" fillWidth="false" prefHeight="227.0" prefWidth="291.0" spacing="10.0"
          AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
          AnchorPane.topAnchor="0.0">
        <opaqueInsets>
            <Insets/>
        </opaqueInsets>
        <padding>
            <Insets bottom="50.0" left="50.0" right="50.0" top="50.0"/>
        </padding>
        <TextField fx:id="userNameField" promptText="username">
            <font>
                <Font name="Rockwell" size="13.0"/>
            </font>
        </TextField>
        <PasswordField fx:id="passwordField" promptText="password">
            <font>
                <Font name="Rockwell" size="13.0"/>
            </font>
        </PasswordField>
        <HBox spacing="10.0">
            <Button fx:id="loginButton" defaultButton="true" mnemonicParsing="false" onAction="#handleLogin"
                    text="Login">
                <font>
                    <Font name="Rockwell" size="13.0"/>
                </font>
            </Button>
            <Button fx:id="registerButton" mnemonicParsing="false" onAction="#handleRegister"
                    text="Register">
                <font>
                    <Font name="Rockwell" size="13.0"/>
                </font>
            </Button>
        </HBox>
        <Label fx:id="statusLabel">
            <font>
                <Font name="Rockwell" size="11.0"/>
            </font>
        </Label>
        <Button fx:id="reconstruct" mnemonicParsing="false" onAction="#onReconstruct"
                style="-fx-background-color: #ff7f7f;" text="Reconstruct">
            <font>
                <Font name="Rockwell" size="12.0"/>
            </font>
        </Button>
    </VBox>
</AnchorPane>
