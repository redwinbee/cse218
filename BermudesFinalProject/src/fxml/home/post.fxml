<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/19"
            fx:controller="controller.home.PostController">
    <children>
        <VBox layoutX="1.0" layoutY="1.0" prefHeight="61.0" prefWidth="149.5" spacing="10.0"
              AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <children>
                <HBox spacing="4.0">
                    <children>
                        <Label fx:id="fullName" text="John Doe" HBox.hgrow="ALWAYS">
                            <font>
                                <Font name="Rockwell" size="13.0"/>
                            </font>
                        </Label>
                        <Label fx:id="userName" text="\@johndoe" textFill="#8a8a8a" HBox.hgrow="ALWAYS">
                            <font>
                                <Font name="Rockwell" size="13.0"/>
                            </font>
                        </Label>
                    </children>
                </HBox>
                <Text fx:id="body" strokeType="OUTSIDE" strokeWidth="0.0" text="Text" wrappingWidth="300.0">
                    <font>
                        <Font name="Rockwell" size="12.0"/>
                    </font>
                </Text>
                <Label fx:id="postTime" text="11/22/22 13:22 EST">
                    <font>
                        <Font size="10.0"/>
                    </font>
                </Label>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
        </VBox>
    </children>
</AnchorPane>
