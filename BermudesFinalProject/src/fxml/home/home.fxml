<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<BorderPane xmlns:fx="http://javafx.com/fxml/1" minHeight="-Infinity" minWidth="-Infinity" prefHeight="373.0"
            prefWidth="532.0" xmlns="http://javafx.com/javafx/19" fx:controller="controller.home.Home">
    <center>
        <ScrollPane hbarPolicy="NEVER" prefHeight="314.0" prefWidth="531.0" vbarPolicy="NEVER"
                    BorderPane.alignment="CENTER">
            <content>
                <VBox fx:id="postsBox"/>
            </content>
        </ScrollPane>
    </center>
    <top>
        <HBox alignment="CENTER" prefHeight="60.0" prefWidth="530.0" spacing="10.0" BorderPane.alignment="CENTER">
            <children>
                <TextArea fx:id="postTextArea" prefHeight="40.0" prefWidth="374.0" promptText="Got something to say?"
                          stylesheets="@../hide_scrollbar.css" wrapText="true">
                    <font>
                        <Font name="Rockwell" size="13.0"/>
                    </font>
                </TextArea>
                <Button fx:id="postButton" defaultButton="true" mnemonicParsing="false" onAction="#onPost"
                        prefHeight="27.0" prefWidth="57.0" text="Post">
                    <font>
                        <Font name="Rockwell" size="13.0"/>
                    </font>
                </Button>
                <Button fx:id="attachButton" mnemonicParsing="false" onAction="#onAttach" text="Attach">
                    <font>
                        <Font name="Rockwell" size="13.0"/>
                    </font>
                </Button>
            </children>
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
        </HBox>
    </top>
</BorderPane>
