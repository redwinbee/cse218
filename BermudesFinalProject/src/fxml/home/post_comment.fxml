<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/19"
            fx:controller="controller.home.PostCommentController">
    <children>
        <VBox layoutX="-0.4951171875" spacing="10.0">
            <children>
                <HBox spacing="10.0">
                    <children>
                        <Label fx:id="fullName" text="John Doe">
                            <font>
                                <Font name="Rockwell" size="13.0"/>
                            </font>
                        </Label>
                        <Label fx:id="userName" text="\@johndoe" textFill="#8a8a8a">
                            <font>
                                <Font name="Rockwell" size="13.0"/>
                            </font>
                        </Label>
                    </children>
                </HBox>
                <Text fx:id="body" strokeType="OUTSIDE" strokeWidth="0.0" text="Text" wrappingWidth="425.0">
                    <font>
                        <Font name="Rockwell" size="13.0"/>
                    </font>
                </Text>
                <Label fx:id="postTime" text="Label">
                    <font>
                        <Font size="12.0"/>
                    </font>
                </Label>
                <HBox spacing="10.0">
                    <children>
                        <TextField fx:id="commentField" promptText="Comment something">
                            <font>
                                <Font name="Rockwell" size="12.0"/>
                            </font>
                        </TextField>
                        <Button fx:id="comment" mnemonicParsing="false" onAction="#onComment" text="Comment">
                            <font>
                                <Font name="Rockwell" size="12.0"/>
                            </font>
                        </Button>
                        <Button fx:id="backButton" mnemonicParsing="false" onAction="#onBack" text="Back">
                            <font>
                                <Font name="Rockwell" size="12.0"/>
                            </font>
                        </Button>
                    </children>
                </HBox>
                <ScrollPane>
                    <content>
                        <VBox fx:id="postComments" spacing="10"/>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</AnchorPane>
